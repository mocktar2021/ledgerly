# Ledgerly environment variables (Chapter 19).
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# Rules:
# - .env.local is gitignored. Never commit it. Never paste real values into a
#   chat, a ticket, or a commit.
# - Every environment gets its own credentials (local, preview, production).
#   Locally, use Stripe TEST mode keys and a non-production Supabase project.
# - Production values live in Vercel's environment variable settings, scoped to
#   Production, not in a file on anyone's laptop.
# - Test for "safe to be public": if a stranger reading everything in the
#   browser's developer tools would be a problem, it is a server secret.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# PUBLIC. Project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# PUBLIC. The anon key is designed to be exposed. It is only safe because Row
# Level Security is enabled on every table. See database/migrations/.
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# SERVER ONLY. Bypasses Row Level Security entirely. Used only for system
# tables (processed_webhook_events, rate_limit_events) and the Stripe webhook
# route. Never use it to make an RLS error go away (see AGENTS.md).
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

# SERVER ONLY. Local and preview: use a TEST mode key (begins with sk_test_).
# Live mode keys belong only in Vercel's Production environment.
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_TEST_SECRET_KEY

# SERVER ONLY. Signing secret for the webhook endpoint (begins with whsec_).
# Locally, get it from the Stripe CLI when forwarding webhooks. In production,
# use the secret of the dashboard-configured endpoint.
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET

# ---------------------------------------------------------------------------
# Sentry (error tracking)
# ---------------------------------------------------------------------------

# PUBLIC. The DSN identifies where to send errors. Safe in the browser.
NEXT_PUBLIC_SENTRY_DSN=REPLACE_WITH_SENTRY_DSN

# Build time only. Organization and project slugs, used for source map upload.
# Not secret, but not needed at runtime.
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug

# SERVER / CI ONLY, optional. Needed only if you upload source maps during the
# build. Keep it in Vercel and GitHub secrets, never in this file.
# SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Testing (optional)
# ---------------------------------------------------------------------------

# Where Playwright points. Defaults to http://localhost:3000 if unset.
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Reminders (optional, NOT read by any code in this companion repository)
# ---------------------------------------------------------------------------
# The book describes email and SMS reminders (Chapters 11 and 18). That code is
# not included here. If you add it, keep these server-side only, in a route
# handler, never in browser code. The variable names below are suggestions.
#
# RESEND_API_KEY=
# SMS_API_KEY=
